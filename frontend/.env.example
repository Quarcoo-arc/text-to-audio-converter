# Leave every value below unset to run the app in mock mode: a fake Google
# sign-in and a fake API, so `npm run dev` works with zero setup. Fill them
# in once the backend (Cognito user pool + API Gateway) exists.

# Cognito User Pool issuer URL, e.g.
# https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=

# App client ID from the Cognito User Pool (the client used by this SPA)
VITE_COGNITO_CLIENT_ID=

# Cognito Hosted UI domain, e.g. https://your-app.auth.<region>.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Where Cognito Hosted UI redirects back to after sign-in. Defaults to the
# app's own origin if left unset.
VITE_COGNITO_REDIRECT_URI=

# Base URL of the backend API, e.g. https://api.example.com
VITE_API_BASE_URL=
